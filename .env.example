# Cloudflare Worker Environment Variables
# Copy this file to .env.local and fill in your actual values
# .env.local should NOT be committed to git

# Apify API Token
# Get from: https://console.apify.com/account/integrations/api
APIFY_TOKEN=your_apify_token_here

# Stripe Webhook Signing Secret
# Get from: https://dashboard.stripe.com/developers/webhooks
# Click on your webhook endpoint and "Reveal" the signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_signing_secret_here

# Worker Secret (random string for protecting admin endpoints)
# Generate with: openssl rand -hex 32
WORKER_SECRET=your_random_worker_secret_here

# Alert Webhook URL (optional)
# For failure notifications via Slack, Discord, etc.
ALERT_WEBHOOK_URL=https://webhook.algorithpro.com/webhook/paidcomplete

# Optional: Override default Apify actor
# APIFY_ACTOR_ID=apify/facebook-marketplace-scraper

# Optional: Override Apify max items
# APIFY_MAX_ITEMS=80
